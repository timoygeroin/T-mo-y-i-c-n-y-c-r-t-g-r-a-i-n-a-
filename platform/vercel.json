{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install --prefix apps/host --no-audit --no-fund",
  "buildCommand": "npm --prefix apps/host run build",
  "outputDirectory": "apps/host/dist",
  "functions": {
    "api/organism/*.mjs": {
      "maxDuration": 120
    }
  }
}
