{
  "name": "@mondayid/platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "External platform scaffold for MondayiD runtime manifestation.",
  "workspaces": [
    "packages/route-governor",
    "packages/processor-fabric",
    "packages/proof-evaluation",
    "packages/corpus-memory",
    "packages/manifestation-engine",
    "packages/continuity-kernel"
  ],
  "scripts": {
    "proof:one": "node one/mondayid-one-proof.mjs",
    "proof:work": "node work/mondayid-work-proof.mjs",
    "proof:focus-object": "node focus-object/focus-object-proof.mjs",
    "proof:focus-object-surface": "node focus-object/focus-object-surface-proof.mjs",
    "proof:focus-object-expertise-release": "node focus-object/focus-object-expertise-release-proof.mjs",
    "proof:focus-object-evidence-transition": "node focus-object/focus-object-evidence-transition-proof.mjs",
    "proof:mondayvision": "node mondayvision/mondayvision-proof.mjs",
    "proof:mondayvision-constraint-gradient": "node mondayvision/constraint-gradient-proof.mjs",
    "proof:cloud-smoke": "node cloud/cloud-smoke.mjs",
    "proof:route-governor": "npm --workspace @mondayid/route-governor run proof:examples",
    "proof:processor-fabric": "npm --workspace @mondayid/processor-fabric run proof:examples",
    "proof:proof-evaluation": "npm --workspace @mondayid/proof-evaluation run proof:examples",
    "proof:corpus-memory": "npm --workspace @mondayid/corpus-memory run proof:examples",
    "proof:manifestation-engine": "npm --workspace @mondayid/manifestation-engine run proof:examples",
    "proof:continuity-kernel": "npm --workspace @mondayid/continuity-kernel run proof:examples",
    "test:route-governor": "npm --workspace @mondayid/route-governor test",
    "typecheck:route-governor": "npm --workspace @mondayid/route-governor run typecheck",
    "typecheck:processor-fabric": "npm --workspace @mondayid/processor-fabric run typecheck",
    "typecheck:proof-evaluation": "npm --workspace @mondayid/proof-evaluation run typecheck",
    "typecheck:corpus-memory": "npm --workspace @mondayid/corpus-memory run typecheck",
    "typecheck:manifestation-engine": "npm --workspace @mondayid/manifestation-engine run typecheck",
    "typecheck:continuity-kernel": "npm --workspace @mondayid/continuity-kernel run typecheck"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "typescript": "^5.8.3"
  }
}
