# Production on Vercel prefers the platform-injected VERCEL_OIDC_TOKEN automatically.
# For local Gateway development, set AI_GATEWAY_API_KEY or pull a Vercel OIDC token.
AI_GATEWAY_API_KEY=
VERCEL_OIDC_TOKEN=

# Optional direct OpenAI fallback for local development. Never commit a real key.
OPENAI_API_KEY=

# Current default compute substrate for the MondayID host runtime.
MONDAYID_MODEL=openai/gpt-5.6-sol
MONDAYID_REASONING=high
MONDAYID_RUNTIME_PORT=8787
