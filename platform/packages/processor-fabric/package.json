{
  "name": "@mondayid/processor-fabric",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bounded virtual processor fabric for MondayiD route work.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./processor-load-intake": { "types": "./dist/processor-load-intake.d.ts", "default": "./dist/processor-load-intake.js" },
    "./processor-quorum": { "types": "./dist/processor-quorum.d.ts", "default": "./dist/processor-quorum.js" },
    "./processor-settlement": { "types": "./dist/processor-settlement.d.ts", "default": "./dist/processor-settlement.js" },
    "./processor-result-receipt": { "types": "./dist/processor-result-receipt.d.ts", "default": "./dist/processor-result-receipt.js" },
    "./processor-source-authority": { "types": "./dist/processor-source-authority.d.ts", "default": "./dist/processor-source-authority.js" },
    "./source-authorized-convergence": { "types": "./dist/source-authorized-convergence.d.ts", "default": "./dist/source-authorized-convergence.js" }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json",
    "proof:examples": "tsc -p tsconfig.json && node dist/index.js && node dist/processor-load-intake-proof.js && node dist/processor-quorum-proof.js && node dist/processor-settlement-proof.js && node dist/processor-result-receipt-proof.js && node dist/processor-source-authority-proof.js && node dist/source-authorized-convergence-proof.js"
  },
  "dependencies": {},
  "devDependencies": {}
}
